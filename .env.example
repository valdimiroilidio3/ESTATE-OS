# ─────────────── ESTATE OS ───────────────
# Copy to .env.local (development) or configure in the host environment (production).
#
# Production start-up:
#   npm ci && cp .env.example .env.local
#   npm run db:init     # schema + plans, empty instance
#   npm run build && npm run start
#   open /signup        # the first account creates the first organisation

# Session signing secret. REQUIRED when NODE_ENV=production, minimum 32 characters.
# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-64-char-random-hex-string

# Public base URL used for share links, canonical URLs, OG metadata and sitemap.xml.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file used by the persistence layer (default: data/estate.db).
# The directory must exist and be writable by the process; it must live on a
# persistent volume. See README §2 "Alojamento" before deploying serverless.
DATABASE_PATH=./data/estate.db

# Force the Secure attribute on the session cookie. Defaults to true in production.
# Set to "false" only when serving over plain HTTP on a private network.
# COOKIE_SECURE=false

# ─────────────── AI PROVIDER ───────────────
# "local" (default) = deterministic rules engine over confirmed property facts.
# It is NOT a language model and the UI labels it as such.
# "openai" = any OpenAI-compatible chat-completions endpoint.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000

# ─────────────── DEMO FIXTURES (optional) ───────────────
# `npm run db:demo` refuses to run with NODE_ENV=production. Setting the flag below
# bypasses that guard for a throwaway database only. It wipes existing data.
# ALLOW_DEMO_SEED=1
