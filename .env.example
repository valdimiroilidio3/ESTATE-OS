# ─────────────── ESTATE OS ───────────────
# Session signing / hashing pepper. Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-64-char-random-hex-string
# Public base URL used for share links, canonical URLs and OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file used by the local persistence layer (default: data/estate.db)
DATABASE_PATH=./data/estate.db

# ─────────────── AI PROVIDER ───────────────
# "local" (default) = deterministic rules engine over confirmed property facts.
# It is NOT a language model and the UI labels it as such.
# "openai" = any OpenAI-compatible chat-completions endpoint.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000
